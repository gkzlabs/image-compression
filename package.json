{
  "name": "@gkzlabs/image-compression",
  "version": "1.5.0",
  "description": "Framework-agnostic image compression for the browser. Zero dependencies — pure web APIs (WebCodecs, OffscreenCanvas, Worker). AVIF/WebP/JPEG output, target-size mode, HEIC decode. Works with any frontend framework (Angular, React, Vue, Svelte) or vanilla JS.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkzlabs/image-compression.git"
  },
  "bugs": {
    "url": "https://github.com/gkzlabs/image-compression/issues"
  },
  "homepage": "https://gkzlabs.github.io/image-compression/",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "dist/index.js",
  "jsdelivr": "dist/index.js",
  "browser": "./dist/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs/BROWSER_COMPAT.md",
    "docs/SERVER_FALLBACK.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node test/browser-smoke.mjs",
    "test:matrix": "node test/browser-matrix.mjs",
    "test:worker": "node test/worker-deep-check.mjs",
    "test:heic2any": "node test/heic2any-real.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "size": "size-limit",
    "bench:fixtures": "node bench/fixtures/generate.mjs",
    "bench": "node bench/runner.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck:test && npm test && npm run build && npm run size && npm run docs",
    "docs": "npx --yes typedoc@0.28.20"
  },
  "keywords": [
    "image",
    "compression",
    "webcodecs",
    "offscreen-canvas",
    "worker",
    "zero-dependency",
    "avif",
    "webp",
    "browser",
    "framework-agnostic",
    "heic",
    "exif",
    "demo",
    "live-demo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "heic2any": "^0.0.4"
  },
  "peerDependenciesMeta": {
    "heic2any": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.65.0",
    "puppeteer": "^25.17.0",
    "size-limit": "^14.3.0",
    "typescript": "^5.4.0",
    "vitest": "^5.1.0"
  }
}
