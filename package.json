{
  "name": "@gkzlabs/image-compression",
  "version": "1.1.0",
  "description": "Framework-agnostic image compression for the browser. Zero dependencies — pure web APIs (WebCodecs, OffscreenCanvas, Worker). AVIF/WebP/JPEG output, target-size mode, HEIC decode. Works with any frontend framework (Angular, React, Vue, Svelte) or vanilla JS.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkzlabs/image-compression.git"
  },
  "bugs": {
    "url": "https://github.com/gkzlabs/image-compression/issues"
  },
  "homepage": "https://gkzlabs.github.io/image-compression/",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "dist/index.js",
  "jsdelivr": "dist/index.js",
  "browser": "./dist/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "size": "size-limit",
    "bench:fixtures": "node bench/fixtures/generate.mjs",
    "bench": "node bench/runner.mjs",
    "prepublishOnly": "npm run lint && npm test && npm run build && npm run size && npm run docs",
    "docs": "typedoc"
  },
  "keywords": [
    "image",
    "compression",
    "webcodecs",
    "offscreen-canvas",
    "worker",
    "zero-dependency",
    "avif",
    "webp",
    "browser",
    "framework-agnostic",
    "heic",
    "exif",
    "demo",
    "live-demo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "peerDependencies": {
    "heic2any": "^0.0.4"
  },
  "peerDependenciesMeta": {
    "heic2any": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "@size-limit/preset-app": "^12.1.0",
    "@types/node": "^20.10.0",
    "happy-dom": "^15.0.0",
    "puppeteer": "^25.1.0",
    "size-limit": "^12.1.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
