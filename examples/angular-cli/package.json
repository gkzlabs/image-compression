{
  "name": "@gkzlabs/image-compression-example-angular-cli",
  "version": "1.3.1",
  "private": true,
  "description": "Angular CLI (esbuild application builder) example for @gkzlabs/image-compression — the hostile bundler case. No worker escape hatch: the worker must resolve through the bundler, and CI drives the production build in a real browser.",
